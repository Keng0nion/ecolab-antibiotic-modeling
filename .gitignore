# macOS and editor-local state
.DS_Store
.zed/
.mimosa/

# Dependencies and generated products
node_modules/
dist/
coverage/
.tmp/
tmp/

# Local raw source artifacts are provenance inputs, not release files.
# The acquisition manifest is tracked because it carries source URLs, byte
# counts, MD5 and SHA-256 values; the XLSX payloads themselves stay local.
data/raw/*
!data/raw/figshare-bw25113-growth-v1/
data/raw/figshare-bw25113-growth-v1/*
!data/raw/figshare-bw25113-growth-v1/acquisition.json
*.xlsx
*.xls

# Local environment and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Logs
*.log
npm-debug.log*
