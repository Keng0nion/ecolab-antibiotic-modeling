{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecolab.local/schemas/protocol.schema.json",
  "title": "Ecolab piecewise-constant single-drug protocol",
  "type": "object",
  "required": ["schemaVersion", "kind", "drugId", "segments"],
  "additionalProperties": false,
  "$defs": {
    "quantity": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "piecewise_constant" },
    "drugId": { "type": "string", "minLength": 1 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "end", "concentration"],
        "additionalProperties": false,
        "properties": {
          "start": { "$ref": "#/$defs/quantity" },
          "end": { "$ref": "#/$defs/quantity" },
          "concentration": { "$ref": "#/$defs/quantity" }
        }
      }
    }
  }
}
