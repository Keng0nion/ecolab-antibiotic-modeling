{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecolab.local/schemas/run-manifest.schema.json",
  "title": "Ecolab reproducible simulation-run manifest",
  "type": "object",
  "required": ["schemaVersion", "kind", "runId", "createdAt", "application", "engine", "model", "parameterSet", "request", "randomness", "warnings", "result"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "ecolab.simulation-run" },
    "runId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "application": { "type": "object" },
    "engine": { "type": "object" },
    "model": { "type": "object" },
    "parameterSet": { "type": "object" },
    "request": { "type": "object" },
    "randomness": {
      "type": "object",
      "required": ["used", "seed"],
      "properties": {
        "used": { "const": false },
        "seed": { "type": "null" }
      }
    },
    "warnings": { "type": "array" },
    "result": { "type": "object" }
  }
}
