{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecolab.local/schemas/model-definition.schema.json",
  "title": "Ecolab model definition registry",
  "type": "object",
  "required": ["schemaVersion", "records"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "implementationId", "stateVariable", "rateConvention", "scheduleKind", "notModeled"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "implementationId": { "type": "string", "minLength": 1 },
          "stateVariable": { "type": "object" },
          "rateConvention": { "const": "log10-fold/h" },
          "scheduleKind": { "const": "piecewise_constant_single_drug" },
          "notModeled": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
